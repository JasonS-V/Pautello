{
  "name": "pautello",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "description": "Pautello - Editor Profesional de Partituras y Notación Musical",
  "license": "MIT",
  "author": "Jason Sting / Pautello Music Team <jasonsting70@gmail.com>",
  "homepage": "https://github.com/JasonS-V/Pautello#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonS-V/Pautello.git"
  },
  "bugs": {
    "url": "https://github.com/JasonS-V/Pautello/issues"
  },
  "keywords": [
    "sheet-music",
    "music-notation",
    "partituras",
    "musicxml",
    "midi",
    "web-audio",
    "electron",
    "react"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --sourcemap",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:compiler": "eslint . --config eslint.compiler.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron:start": "electron .",
    "package:win": "pnpm build:desktop && electron-builder --win --x64",
    "package:mac": "pnpm build:desktop && npx @electron/packager . \"Pautello\" --platform=darwin --arch=arm64,x64 --out=release --overwrite --asar --no-prune --ignore=\"^/(node_modules|src|coverage|\\.git|\\.github|partituras_reales|tasks|release)\" --app-bundle-id=com.pautello.partituras --app-category-type=public.app-category.music",
    "package:mac:builder": "pnpm build:desktop && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.pautello.partituras",
    "productName": "Pautello - Editor de Partituras",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "Pautello-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "artifactName": "Pautello-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal",
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "universal",
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pautello necesita acceso al micrófono para la afinación y detección de notas en tiempo real."
      }
    },
    "dmg": {
      "title": "Pautello ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pautello Partituras"
    }
  }
}
